### ====================================================================
### [사전 준비] 테스트 전 MySQL DB에 먼저 아래 SQL을 실행해 주세요!
###
### INSERT INTO users (id, name, current_point, status)
### VALUES (1, '테스트유저', 5000, 'ACTIVE');
###
### INSERT INTO items (id, name, price, is_active, item_type, image_url, rarity)
### VALUES (1, '빨간 모자', 1000, 1, 'HAT', 'red_hat.png', 1);
### INSERT INTO items (id, name, price, is_active, item_type, image_url, rarity)
### VALUES (2, '파란 캡모자', 1500, 1, 'HAT', 'blue_cap.png', 1);
### ====================================================================

@hostname = localhost
@port = 8080
@baseUrl = http://{{hostname}}:{{port}}

### 1. 상점 아이템 구매 (빨간 모자 - 1000포인트)
POST {{baseUrl}}/api/shop/purchase
Content-Type: application/json

{
  "userId": 1,
  "itemId": 1
}

### 2. 상점 아이템 구매 (파란 캡모자 - 1500포인트)
POST {{baseUrl}}/api/shop/purchase
Content-Type: application/json

{
  "userId": 1,
  "itemId": 2
}

### 3. 상점 아이템 중복 구매 테스트 (에러가 발생해야 정상!)
# 똑같은 1번 아이템을 다시 사려고 하면 "이미 보유하고 있는 아이템입니다." 예외가 터져야 합니다.
POST {{baseUrl}}/api/shop/purchase
Content-Type: application/json

{
  "userId": 1,
  "itemId": 1
}


### 4. 인벤토리 목록 조회 (순환 참조 폭탄 제거 검증)
# 응답 결과로 유저 정보 없이 아이템 정보만 JSON 리스트로 예쁘게 잘 나오는지 확인합니다.
GET {{baseUrl}}/api/inventory/1
Accept: application/json


### 5. 인벤토리 1번 아이템(빨간 모자) 장착하기
# 실행 후 DB나 다음 조회 시 isEquipped가 true로 바뀌어야 합니다.
PATCH {{baseUrl}}/api/inventory/1/equip
Content-Type: application/json

{
  "userId": 1
}


### 6. 인벤토리 2번 아이템(파란 캡모자) 장착하기 (★자동 해제 로직 검증)
# 같은 HAT 타입인 2번을 장착하면, 기존에 장착되어 있던 1번 빨간 모자는 자동으로 false가 되어야 합니다.
PATCH {{baseUrl}}/api/inventory/2/equip
Content-Type: application/json

{
  "userId": 1
}


### 7. 최종 인벤토리 목록 다시 조회하여 장착 상태 확인
# 최종적으로 1번은 isEquipped: false, 2번은 isEquipped: true 상태여야 성공입니다!
GET {{baseUrl}}/api/inventory/1
Accept: application/json